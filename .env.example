# ─────────────────────────────────────────────────────────────────────────────
# Intelligent Market Research Assistant — Environment Variables
# Copy this file to .env and fill in your values.
# ALL variables are optional when DEMO_MODE=true (or when WATSONX_API_KEY is absent).
# ─────────────────────────────────────────────────────────────────────────────

# ── IBM watsonx.ai credentials ───────────────────────────────────────────────
# Obtain from: https://cloud.ibm.com → watsonx.ai → Manage → API keys
WATSONX_API_KEY=

# Your watsonx.ai project ID (shown in the project settings page)
WATSONX_PROJECT_ID=

# watsonx.ai regional endpoint — default is us-south
# Other options: eu-de, eu-gb, jp-tok, au-syd
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── IBM Granite model ─────────────────────────────────────────────────────────
# Default: ibm/granite-3-8b-instruct
# Other options: ibm/granite-3-2b-instruct, ibm/granite-13b-instruct-v2
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# ── NewsAPI.org (optional) ────────────────────────────────────────────────────
# Free key from: https://newsapi.org/register
# If absent, the app uses bundled sample_news.json instead.
NEWSAPI_KEY=

# ── Demo / offline mode ───────────────────────────────────────────────────────
# Set to true to force demo mode regardless of whether credentials are present.
# The app auto-activates demo mode when WATSONX_API_KEY is blank.
DEMO_MODE=false
